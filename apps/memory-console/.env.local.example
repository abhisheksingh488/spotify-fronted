# The console's own server settings. Neither is NEXT_PUBLIC_, so neither ever
# reaches the browser.

# Where the backend API is.
MEMORY_API_BASE_URL=http://127.0.0.1:8000

# The same secret the backend signs its tokens with - copy it from the backend's
# .env. Used only to check the pass a person gets when they log in
# (lib/session.ts); the app no longer makes passes itself.
MEMORY_JWT_SECRET=copy-this-from-the-backend-dot-env
