# The controls app is server-side only; none of these reach the browser.

MEMORY_API_BASE_URL=http://127.0.0.1:8000

# Copy from the backend .env. Used only to check the pass a listener gets
# when they log in (lib/session.ts) - this app no longer makes passes itself.
MEMORY_JWT_SECRET=copy-this-from-the-backend-dot-env

# There is no fixed listener any more: each person logs in with their own
# user id and password (app/login/page.tsx).
